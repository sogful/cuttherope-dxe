if not game:GetService("RunService"):IsStudio() then return end
local shared=game.ReplicatedStorage.CutTheRope.Shared
local Data=require(shared.ProgressData)
local Store=require(shared.ProgressStore)
local Session=require(shared.SessionState)
local root=Instance.new("Folder",game.Players.LocalPlayer.PlayerGui) root.Name="DxProgressChecks"
local results={}
local function check(name,fn)
	local ok,message=pcall(fn) results[name]=ok and "PASS" or tostring(message)
	if not ok then warn("DX PROGRESS",name,message) end
end
check("NormalProgressionAndThresholds",function()
	local p=Data.new() assert(Data.levelUnlocked(p,1,1) and not Data.levelUnlocked(p,1,2) and not Data.packUnlocked(p,2))
	Data.complete(p,1,1,Data.result(60,0)) assert(Data.levelUnlocked(p,1,2) and not Data.levelUnlocked(p,1,3))
	for level=1,10 do Data.complete(p,1,level,Data.result(10,3)) end
	assert(Data.total(p)==30 and Data.packUnlocked(p,2) and not Data.packUnlocked(p,3))
	Data.unlockNext(p,2,1) assert(Data.levelUnlocked(p,2,2))
	assert(not Data.levelUnlocked(p,18,1) and not Data.levelUnlocked(p,1,26))
end)
check("CheatUsesDisposableCopy",function()
	Session.load(Data.new()) Session.complete(1,1,Data.result(12,2))
	local expected=game.HttpService:JSONEncode(Session.export())
	Session.setUnlockAll(true) assert(Session.levelUnlocked(17,25))
	Session.complete(17,25,Data.result(1,3)) Session.reset()
	assert(game.HttpService:JSONEncode(Session.export())==expected,"cheat changed real save")
	Session.setUnlockAll(false)
	assert(Session.record(1,1).stars==2 and Session.record(17,25).stars==0)
	assert(Session.levelUnlocked(1,2) and not Session.levelUnlocked(1,3) and not Session.packUnlocked(2))
	Session.setUnlockAll(true) Session.complete(1,2,Data.result(1,3)) Session.setUnlockAll(false)
	assert(Session.record(1,2).stars==0)
	Session.load(Data.new())
end)
local memory,fail,now={},false,1000
local adapter={UpdateAsync=function(_,key,transform)
	if fail then error("injected datastore failure") end
	local next=transform(Data.copy(memory[key]))
	if next then memory[key]=Data.copy(next) return Data.copy(next) end
end}
check("SaveReloadLeaseAndServerCheatIsolation",function()
	local first=Store.new(adapter,"first",function() return now end)
	local second=Store.new(adapter,"second",function() return now end)
	local a=assert(first:open("user")) assert(not second:open("user"))
	assert(first:command(a,{kind="complete",pack=1,level=1,stars=3,elapsed=10}))
	assert(not first:command(a,{kind="complete",pack=17,level=25,stars=3,elapsed=10}))
	assert(first:command(a,{kind="cheat",enabled=true}))
	assert(not first:command(a,{kind="reset"}))
	assert(not first:command(a,{kind="complete",pack=1,level=2,stars=3,elapsed=10}))
	assert(first:command(a,{kind="settings",settings={locale="ja",sound=false}}))
	assert(first:save(a,true))
	local b=assert(second:open("user"))
	assert(b.profile.records["1:1"].stars==3 and b.profile.records["1:2"]==nil and b.profile.settings.locale=="ja")
	assert(not b.cheat and Data.levelUnlocked(b.profile,1,2))
	assert(second:save(b,true))
end)
check("LoadFailureNeverOverwritesAndFailedSaveRetries",function()
	local first=Store.new(adapter,"failtest",function() return now end)
	local previous=Data.copy(memory.user)
	fail=true assert(not first:open("user")) assert(memory.user.records["1:1"].score==previous.records["1:1"].score)
	fail=false local a=assert(first:open("user"))
	first:command(a,{kind="complete",pack=1,level=2,stars=2,elapsed=20})
	fail=true assert(not first:save(a)) assert(a.saved~=a.revision and not a.closed)
	fail=false assert(first:save(a,true)) assert(memory.user.records["1:2"].stars==2)
end)
check("ExpiredOwnerCannotOverwriteNewSession",function()
	local a=Store.new(adapter,"old",function() return now end)
	local b=Store.new(adapter,"new",function() return now end)
	local old=assert(a:open("user")) now+=181
	local new=assert(b:open("user"))
	assert(not a:save(old) and old.closed) assert(memory.user.owner=="new")
	assert(b:command(new,{kind="reset"})) assert(b:save(new,true))
	assert(next(memory.user.records)==nil and memory.user.settings.locale=="ja")
end)
root:SetAttribute("Results",game.HttpService:JSONEncode(results)) root:SetAttribute("Complete",true)
